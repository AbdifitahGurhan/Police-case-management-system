PORT=5000

NODE_ENV=production

DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=police_cms

# Railway MySQL connection URL. Prefer MYSQL_PRIVATE_URL inside Railway services.
# MYSQL_PRIVATE_URL=mysql://user:password@host:port/database
# MYSQL_URL=mysql://user:password@host:port/database
# DATABASE_URL=mysql://user:password@host:port/database

# Optional source DB override for migrate:local-to-railway.
# LOCAL_DB_HOST=127.0.0.1
# LOCAL_DB_PORT=3306
# LOCAL_DB_USER=root
# LOCAL_DB_PASSWORD=
# LOCAL_DB_NAME=police_cms

MONGODB_URI=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

JWT_SECRET=your_secure_jwt_secret
JWT_EXPIRES_IN=24h

FRONTEND_URL=https://your-frontend-url

UPLOAD_DIR=uploads
