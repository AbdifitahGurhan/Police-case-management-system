{
  "name": "police-cms-backend",
  "version": "1.0.0",
  "description": "Backend API for Web-Based Criminal Case Management System",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node database/seed.js",
    "test": "node --test test/*.test.js",
    "migrate:workflow": "node database/workflow_integrity_migration.js",
    "migrate:legal-warrants": "node database/legal_warrants_usd_migration.js",
    "migrate:hierarchy-profiles": "node database/hierarchy_profile_migration.js",
    "migrate:ob-case-module": "node database/ob_case_module_migration.js",
    "data:reset-operational": "node database/reset_operational_data.js",
    "migrate:permissions": "node database/dynamic_permissions_migration.js",
    "migrate:missing-permissions": "node database/missing_permissions_catalog_migration.js",
    "migrate:officer-approval": "node database/officer_approval_migration.js",
    "migrate:user-officer-link": "node database/user_officer_link_migration.js",
    "migrate:permission-audit-completion": "node database/permission_audit_completion_migration.js",
    "migrate:region-admin-accounts": "node database/region_admin_accounts_migration.js",
    "migrate:officer-personal-fields": "node database/officer_personal_fields_migration.js",
    "repair:workflow": "node scripts/repairClosedWorkflow.js",
    "test:system": "node scripts/systemSmokeTest.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.21",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
